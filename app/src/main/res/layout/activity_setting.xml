<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="20dp">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nickname -->
            <LinearLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/nicknameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nickname"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <EditText
                    android:id="@+id/nicknameInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/input_nickname"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded_background"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B3FFFFFF"/>

            </LinearLayout>


            <LinearLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/ageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/age"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button_decrement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt;"
                        android:background="#00000000"/>

                    <EditText
                        android:id="@+id/edit_age_number"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:gravity="center_horizontal"
                        android:text="100"
                        android:textColor="@color/white"
                        android:background="@drawable/edittext_rounded_background"/>

                    <Button
                        android:id="@+id/button_increment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:background="#00000000"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Gender -->
            <LinearLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/genderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gender"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <EditText
                    android:id="@+id/genderInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/input_gender"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded_background"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B3FFFFFF"/>

            </LinearLayout>

            <!-- Address -->
            <LinearLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/addressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/address"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <EditText
                    android:id="@+id/addressInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/input_address"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded_background"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B3FFFFFF"/>

            </LinearLayout>
            <!-- Style -->
            <LinearLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/styleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/style"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <EditText
                    android:id="@+id/styleInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/input_style"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded_background"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B3FFFFFF"/>

            </LinearLayout>

            <!-- Save Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/save_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:background="@drawable/button_red_rounded"
                android:textColor="@android:color/white"
                android:layout_marginTop="24dp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
