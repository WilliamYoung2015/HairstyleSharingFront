<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Define the shape as a rectangle -->
    <solid android:color="#4A4A4A"/> <!-- Background color of the EditText -->

    <!-- Customize the corners -->
    <corners android:radius="40dp"/> <!-- This defines the rounded corner radius -->

    <!-- Optionally, define a padding -->
    <padding
        android:left="16dp"
        android:top="8dp"
        android:right="16dp"
        android:bottom="8dp" />

    <!-- Optionally, define a stroke -->
    <stroke
        android:width="1dp"
        android:color="#FF000000"/> <!-- Stroke color -->
</shape>
